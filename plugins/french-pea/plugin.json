        "dev/cashle/accounts/fr_pea/FrenchPeaPlugin_en.properties",
        "dev/cashle/accounts/fr_pea/FrenchPeaPlugin_sv.properties"
      ]
    },
    {
      "path": "french-pea-tax.cashle",
      "resources": [
        "dev/cashle/accounts/fr_pea/FrenchPeaTaxPolicy_en.properties",
        "dev/cashle/accounts/fr_pea/FrenchPeaTaxPolicy_sv.properties"
      ]
    }
  ]
}
