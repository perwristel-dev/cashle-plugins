{
  "id": "cashle.finance.fr-pea",
  "archive": "cashle-account-fr-pea-source.zip",
  "requires": [
    "cashle.finance",
    "cashle.account.support",
    "cashle.account.tax.support"
  ],
  "ui": "ui.js",
  "uiTranslations": [
    {
      "locale": "en",
      "path": "ui-en.json"
    },
    {
      "locale": "sv",
      "path": "ui-sv.json"
    }
  ],
  "sources": [
    {
      "path": "french-pea.cashle",
