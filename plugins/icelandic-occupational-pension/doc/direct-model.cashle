plugins {
    id 'cashle.finance'
    id 'cashle.tax'
    id 'groovy-cashle-plugin'
    id 'cashle.finance.pension.is-occupational' from '../icelandic-occupational-pension.cashle'
    id 'cashle.tax.is' from '../../icelandic-tax/icelandic-tax.cashle'
}

finance {
    language 'en'
    plan { from '2026-01-01'; until '2026-03-01'; currency 'ISK'; inflation 0d }
    person('self') { name 'Example worker'; birthYear 1959; birthMonth 1 }
    tax {
        country 'IS'
        preliminaryRate 0d
        options([ruleYear:2026, residency:'full-year', municipalRate:0.1494d,
                 period:'annual', pensionContribution:0d, additionalPensionContribution:0d])
    }
    icelandicOccupationalPension('fund') {
        name 'Occupational pension fund'
        settings([monthlyPension:230000d, earliestClaimAge:60, latestClaimAge:80,
                  payoutStart:[reference:'age', age:67], paymentTiming:'month-end'])
    }
}
collect {}
