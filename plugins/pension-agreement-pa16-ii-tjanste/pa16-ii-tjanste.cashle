import dev.cashle.pension.agreement.PensionAgreement.ContributionInput
import dev.cashle.pension.agreement.PensionAgreement.Kind

import static Pa16AgreementRules.*
import static SwedishAgreementRules.*

def sectionIIOccupational = localized('PA16-II-tjanste', 63, 10)
pensionAgreement('PA16-II-tjanste') {
    pluginId 'cashle.pension.agreement.PA16-II-tjanste'
    kind Kind.DEFINED_CONTRIBUTION
    metadata sectionIIOccupational('sv')
    localizedMetadata sectionIIOccupational
    eligible { ContributionInput input -> pa16IIEligible(input) }
    historicalContributionBreakpoints { ContributionInput input -> thresholds(input, 30d) }
    contribution { ContributionInput input -> pa16IIEligible(input) ? cappedPremium(input, .02d) : 0d }
}
