import dev.cashle.core.Frequency
import dev.cashle.core.i18n.Messages
import dev.cashle.sdk.composition.ModuleContext
import dev.cashle.sdk.composition.ModuleInput
import dev.cashle.sdk.finance.FinanceContext
import dev.cashle.sdk.finance.FinanceModule
import dev.cashle.sdk.finance.FundingPort
import dev.cashle.sdk.composition.AccountRef
import dev.cashle.sdk.model.FlowHandle
import dev.cashle.sdk.model.ScheduleSpec
import groovy.transform.CompileStatic
import java.time.LocalDate
import java.util.function.Supplier

financeModule('cashlab.dutch-lijfrente-payout', 1) {
    pluginId 'cashle.finance.nl-lijfrente.payout'
    dsl('nlLijfrentePayment') { id -> [name: id, owner: 'self'] }
    factory { ModuleInput input -> new DutchLijfrentePayment(input) }
}

@CompileStatic
final class DutchLijfrentePayment implements FinanceModule {
    private final ModuleInput entry
    private FlowHandle payment
    private Supplier<LocalDate> end, life

    DutchLijfrentePayment(ModuleInput entry) { this.entry = entry }
    @Override void declare(ModuleContext ignored) {}

    @Override void wireFinance(FinanceContext finance) {
        Map<String,Object> data = entry.data()
        Messages messages = finance.messages(DutchLijfrentePayment, 'lijfrente.Messages')
        Object reference = data.get('accountId')
        if (!(reference instanceof String) || ((String) reference).isBlank()) throw new IllegalArgumentException(messages.text('invalid.link'))
        def capital = finance.require(AccountRef.account((String) reference))
        if (capital.getEconomicNature()?.code() != 'asset.pension') throw new IllegalArgumentException(messages.text('invalid.link'))
        if (!finance.claimExclusive(capital, 'cashle.finance.nl-lijfrente.payout')) throw new IllegalArgumentException(messages.text('invalid.duplicate'))
        LocalDate start = LocalDate.parse(Objects.toString(data.get('contractStart'), ''))
        double years = readNumber(data.get('contractYears'))
        double monthly = readNumber(data.get('monthlyPayoutEur'))
        if (start.dayOfMonth != 1 || years < 20d || years > 100d || years != Math.rint(years) ||
            !Double.isFinite(monthly) || monthly <= 0d) throw new IllegalArgumentException(messages.text('invalid.contract'))
        LocalDate expiry = start.plusYears((long) years)
        if (!expiry.isAfter(finance.from())) return
        double fx = finance.exchangeRate('EUR', Objects.toString(finance.profile().get('currency'), 'EUR'))
        life = finance.lifeEnd(Objects.toString(data.get('owner'), 'self'))
        end = () -> {
            LocalDate died = life.get()
            died != null && died.isBefore(expiry) ? died : expiry
        }
        ScheduleSpec dates = ScheduleSpec.every(Frequency.MONTH, start).within(finance.from(), expiry)
        def model = finance.model()
        payment = model.flow(dates, finance.cash(), capital, () -> {
            if (!model.clock().getDate().isBefore(end.get())) return 0d
            double amount = monthly * fx
            if (capital.getBalance() + 1e-7d < amount) throw new IllegalArgumentException(messages.text('invalid.balance'))
            amount
        })
    }

    @Override void funding(FundingPort port) {
        // The investment policy supplies the taxable annual benefit from the actual capital withdrawal.
        if (payment != null) port.receiptUntil(payment, FundingPort.ReceiptTax.TAX_FREE, false, end)
    }

    private static double readNumber(Object raw) { raw instanceof Number ? ((Number) raw).doubleValue() : Double.NaN }
}
