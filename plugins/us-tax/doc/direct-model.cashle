// 2026 ordinary bracket boundary for an individual Texas resident.
plugins {
    id 'cashle.finance'
    id 'cashle.finance.income'
    id 'cashle.tax'
    id 'groovy-cashle-plugin'
    id 'cashle.tax.us' from '../us-tax.cashle'
}

finance {
    plan { from '2026-01-01'; until '2027-01-02'; currency 'USD'; inflation 0d }
    person('self') { name 'Example resident'; birthYear 1990; birthMonth 1 }
    tax {
        country 'US'
        preliminaryRate 0d
        options([ruleYear: 2026, residency: 'full-year', state: 'TX', filingStatus: 'single',
            openingShortTermCapitalLoss: 0d, openingLongTermCapitalLoss: 0d])
    }
    salary('job') {
        name 'Example salary'
        owner 'self'
        amount 66500d
        frequency 'annual'
        taxTreatment 'taxable'
    }
}
collect {}
