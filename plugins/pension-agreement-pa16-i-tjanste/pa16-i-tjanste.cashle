import dev.cashle.pension.agreement.PensionAgreement.ContributionInput
import dev.cashle.pension.agreement.PensionAgreement.Kind

import static Pa16AgreementRules.*
import static SwedishAgreementRules.*

def sectionIOccupational = localized('PA16-I-tjanste', 63, 10)
pensionAgreement('PA16-I-tjanste') {
    pluginId 'cashle.pension.agreement.PA16-I-tjanste'
    kind Kind.DEFINED_CONTRIBUTION
    metadata sectionIOccupational('sv')
    localizedMetadata sectionIOccupational
    eligible { ContributionInput input -> pa16IEligible(input) }
    historicalContributionBreakpoints { ContributionInput input -> thresholds(input, 7.5d) }
    contribution { ContributionInput input -> pa16IEligible(input) ? uncappedPremium(input, .02d, .10d) : 0d }
}
