{
  "id": "cashle.finance.it-pir",
  "archive": "cashle-account-it-pir-source.zip",
  "requires": [
    "cashle.finance",
    "cashle.account.support",
    "cashle.account.tax.support"
  ],
  "ui": "ui.js",
  "uiTranslations": [
    {
      "locale": "en",
      "path": "ui-en.json"
    },
    {
      "locale": "sv",
      "path": "ui-sv.json"
    }
  ],
  "sources": [
    {
      "path": "italian-pir.cashle",
      "resources": [
        "dev/cashle/accounts/it_pir/ItalianPirPlugin_en.properties",
        "dev/cashle/accounts/it_pir/ItalianPirPlugin_sv.properties"
      ]
    },
    {
      "path": "italian-pir-tax.cashle",
      "resources": [
        "dev/cashle/accounts/it_pir/ItalianPirTaxPolicy_en.properties",
        "dev/cashle/accounts/it_pir/ItalianPirTaxPolicy_sv.properties"
      ]
    }
  ]
}
