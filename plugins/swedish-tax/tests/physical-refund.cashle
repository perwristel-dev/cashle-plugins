plugins {
    id 'cashle.finance'
    id 'cashle.tax'
    id 'cashle.tax.se'
    id 'cashle.tax.se.runtime'
}
finance {
    language 'en'
    plan { from '2026-06-01'; until '2026-06-03'; currency 'SEK'; inflation 0d }
    person('self') { birthYear 1980; birthMonth 1 }
    tax {
        country 'SE'; preliminaryRate 0d
        options([ruleYear:2025, residentMonths:12, municipality:'0180', municipalRate:0.306d,
                 burialFeeRate:0.00293d, communityMember:false])
        settings([
            openingAssessments:[[personId:'self', taxYear:2025, status:'pending', netTax:-1000d, remainingTax:-1000d,
                decisionDate:'2026-06-01', postingDate:'2026-06-02', settlementDate:'2026-06-02']],
            physicalTaxAccounts:[[personId:'self', openingBalance:0d, historyFrom:'2026-01-01', historyOpeningBalance:0d,
                creditRemainder:0d, costRemainder:0d, historicalMovements:[], historicalInterest:[], historicalReconciliations:[],
                rates:[[from:'2026-01-01', creditPercent:0d, lowCostPercent:0d, highCostPercent:0d]],
                overdue:[], reconciliations:['2026-06-02'], forecastNotices:[], futureDeposits:[], refundPolicy:'FULL_AVAILABLE']]
        ])
    }
}
collect { }
