package cashle.plugins.sweden.tax

import groovy.transform.CompileStatic
import dev.cashle.tax.*

import java.io.*
import java.nio.charset.StandardCharsets
import java.time.*
import java.util.*
import static dev.cashle.tax.support.Inputs.*

/** Resolved Swedish 2025 final assessment ported from DECCF; see SOURCES.md. */
@CompileStatic
final class SwedishIncomeTax {
    static final int RULE_YEAR = 2025
    static final Set<String> SOURCE_BASES = Set.of("salary", "pension", "capitalIncome", "interestExpenses", "businessIncome", "privateHomeGain")
    static final Set<String> NON_MONETARY_BASES = Set.of("se.ink1.15.rental-housing-units")

    static double paidInterestDeductibleFraction(String security) {
        switch (security) {
            case "secured": return 1d
            case "unsecured": return 0.5d
            default: throw new IllegalArgumentException("Select whether the loan meets the interest-deduction security requirements")
        }
    }

    static boolean validDepartureOptions(Map<String,Object> options) {
        Object rawRules = options.get("rules")
        if (!(rawRules instanceof Map)) return false
        Map<?,?> rules = (Map<?,?>) rawRules
        return Set.of("rules").containsAll(options.keySet())
            && Set.of("afterEmigrationLiability").containsAll(rules.keySet())
            && Set.of("limited","unlimited").contains(rules.get("afterEmigrationLiability"))
    }

    static List<String> incomeBases() {
        Set<String> bases = new LinkedHashSet<>(BASES)
        bases.addAll(SOURCE_BASES)
        bases.addAll(SOURCE_CAPITAL_BASES)
        bases.add("privateHomeLoss")
        return List.copyOf(bases)
    }

    static boolean supportsBasis(String basis) {
        return basis != null && (BASES.contains(basis) || Set.of("salary", "capitalIncome", "interestExpenses", "businessIncome", "privateHomeGain", "privateHomeLoss").contains(basis) || SOURCE_CAPITAL_BASES.contains(basis))
    }
    static Set<String> accumulationBases(String basis) {
        if(SOURCE_CAPITAL_BASES.contains(basis))return Set.of("capitalIncome")
        if ("privateHomeGain".equals(basis)) return Set.of("privateHomeGain","privateHomeLoss")
        require(supportsBasis(basis), "Unsupported tax basis: " + basis)
        return Set.of(basis)
    }
    static Set<String> accumulationBases(String basis,Map<String,Object> sourceOptions) {
        validateSourceOptions(sourceOptions)
        return accumulationBases(basis)
    }
    static Map<String,Double> classifyMovement(String basis,double amount,Map<String,Object> sourceOptions) {
        validateSourceOptions(sourceOptions)
        return classifyMovement(basis,amount)
    }
    static Map<String,Double> classifyMovement(String basis,double amount) {
        if(SOURCE_CAPITAL_BASES.contains(basis)) {
            require(Double.isFinite(amount),"Capital income must be finite.")
            return Map.of("capitalIncome",amount)
        }
        if("privateHomeGain".equals(basis)) {
            require(Double.isFinite(amount),"Private-home gain must be finite.")
            return amount>=0?Map.of("privateHomeGain",amount):Map.of("privateHomeLoss",-amount)
        }
        require(supportsBasis(basis), "Unsupported tax basis: " + basis)
        require(Double.isFinite(amount), "Tax source movement must be finite.")
        return Map.of(basis, amount)
    }
    static boolean retainsSourceInvestmentRegime(Map<String,Object> assessmentOptions) {
        return unlimitedAfterEmigration(assessmentOptions)
    }
    static Map<String,Object> emigrationSourceOptions(Map<String,Object> countryOptions,Map<String,Object> inheritedOptions) {
        def options=new LinkedHashMap<>(countryOptions)
        options.putAll(inheritedOptions)
        validateSourceOptions(options)
        return Map.copyOf(options)
    }
    static Map<String,Object> investmentSourceOptions(String kind,Map<String,Object> sourceOptions) {
        def options=new LinkedHashMap<>(sourceOptions)
        options.keySet().removeIf(key->key.startsWith("foreign")||Set.of("noWashSaleConfirmed","noSuperficialLossConfirmed",
            "spanishLossDeductibilityConfirmed","singleLotConfirmed").contains(key))
        validateSourceOptions(options)
        return Map.copyOf(options)
    }
    static Map<String,Object> residenceYearOptions(Map<String,Object> options,int residentMonths,String currentResidence) {
        require(residentMonths>=0&&residentMonths<=12,"Calendar months of Swedish residence must be from zero through twelve.")
        if("SE".equalsIgnoreCase(currentResidence))return options
        boolean unlimited=unlimitedAfterEmigration(options)
        def adjusted=new LinkedHashMap<>(options)
        def rules=new LinkedHashMap<>(map(options,"rules"))
        // The existing ordinary engine's valid range starts at one. With no
        // ordinary earned income this proxy grants neither basic nor job credit.
        rules.put("residentMonths",unlimited?12:Math.max(1,residentMonths))
        adjusted.put("rules",rules)
        if(!unlimited&&residentMonths==0&&options.containsKey("taxBases")) {
            def bases=new LinkedHashMap<>(map(options,"taxBases"))
            bases.keySet().removeIf(key->key.startsWith("se.tax.credit.")&&!key.equals("se.tax.credit.foreign-tax"))
            adjusted.put("taxBases",bases)
        }
        return adjusted
    }
    static SourceAssessment classifySource(SourceContext context,String basis,double amount) {
        validateSourceOptions(context.sourceOptions())
        boolean departed=context.lastEmigrationDate()!=null&&!context.paymentDate().isBefore(context.lastEmigrationDate())
        if(!departed||"SE".equals(context.residenceCountry())) {
            if(!"SE".equals(context.residenceCountry()))return SourceAssessment.excluded()
            return new SourceAssessment(classifyMovement(basis,amount),0,0)
        }
        boolean unlimited=unlimitedAfterEmigration(context.assessmentOptions())
        if("capitalIncome".equals(basis)) {
            String sourceKind=sourceOption(context.sourceOptions(),"sourceKind","unknown")
            if(SOURCE_CAPITAL_BASES.contains(sourceKind))basis=sourceKind
            else require(unlimited,"Select an explicit supported Swedish nonresident capital source kind; unknown asset gains cannot be treated as bank interest.")
        }
        if(Set.of("salary","employment","pension").contains(basis)) {
            double allowance=SwedishEmigrationPolicy.publicPensionAllowance(context.paymentDate().getYear()).monthlySek()
            if(context.paymentDate().getYear()>2026)allowance*=context.allowanceInflationFactor()
            def assessed=SwedishEmigrationPolicy.assessIncome(context.paymentDate(),unlimited,basis,amount,
                context.originCountry(),context.residenceCountry(),context.sourceOptions(),context.monthlyAllowanceUsedNative(),allowance)
            def ordinary=assessed.ordinaryTaxableSek()==0?Map.<String,Double>of():classifyMovement(basis,assessed.ordinaryTaxableSek())
            return new SourceAssessment(ordinary,assessed.definitiveTaxSek(),assessed.publicAllowanceUsedSek())
        }
        def kind = capitalKind(basis, amount)
        if(kind==null) {
            require(unlimited,"This source needs an explicit supported Swedish nonresident classification: "+basis)
            return new SourceAssessment(classifyMovement(basis,amount),0,0)
        }
        def security = securitiesClassification(sourceOption(context.sourceOptions(), "securitiesClassification", "unknown"))
        double rate=number(context.sourceOptions(),"treatyCouponRate",0.30d)
        double classifiedAmount=kind==SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_LOSS?Math.abs(amount):amount
        def capital=SwedishEmigrationPolicy.assessCapital(context.paymentDate(),context.lastEmigrationDate(),
            unlimited?SwedishEmigrationPolicy.Liability.UNLIMITED:SwedishEmigrationPolicy.Liability.LIMITED,
            new SwedishEmigrationPolicy.CapitalIncome(classifiedAmount,context.originCountry(),kind,security,
                sourceConfirmed(context.sourceOptions(),"securitiesTreatyExemptionConfirmed"),rate))
        String ordinaryBasis=kind==SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_LOSS?"privateHomeLoss":
            kind==SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_GAIN?"privateHomeGain":"capitalIncome"
        return new SourceAssessment(capital.ordinaryTaxableSek()==0?Map.<String,Double>of():Map.of(ordinaryBasis,capital.ordinaryTaxableSek()),capital.definitiveTaxSek(),0)
    }

    private static SwedishEmigrationPolicy.CapitalKind capitalKind(String basis, double amount) {
        switch (basis) {
            case "capitalIncome":
            case "bankInterest": return SwedishEmigrationPolicy.CapitalKind.BANK_INTEREST
            case "dividendIncome": return SwedishEmigrationPolicy.CapitalKind.DIVIDEND
            case "securitiesGains": return SwedishEmigrationPolicy.CapitalKind.SECURITY_GAIN
            case "privateHomeGain": return amount >= 0 ? SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_GAIN : SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_LOSS
            case "privateHomeLoss": return SwedishEmigrationPolicy.CapitalKind.PRIVATE_HOME_LOSS
            case "propertyRentalIncome": return SwedishEmigrationPolicy.CapitalKind.PROPERTY_RENTAL
            default: return null
        }
    }

    private static SwedishEmigrationPolicy.SecuritiesClassification securitiesClassification(String selected) {
        switch (selected) {
            case "qualifying-shares": return SwedishEmigrationPolicy.SecuritiesClassification.QUALIFYING_SHARES
            case "fund": return SwedishEmigrationPolicy.SecuritiesClassification.FUND
            case "excluded": return SwedishEmigrationPolicy.SecuritiesClassification.EXCLUDED
            case "unknown": return SwedishEmigrationPolicy.SecuritiesClassification.UNKNOWN
            default: throw new IllegalArgumentException("Unsupported Swedish securities classification.")
        }
    }

    private static final Set<String> SOURCE_CAPITAL_BASES=Set.of("bankInterest","dividendIncome","securitiesGains","propertyRentalIncome")
    private static final Set<String> SOURCE_OPTIONS=Set.of("sourceKind","workCountry","pensionKind","employmentProfile","foreignEmploymentExemption",
        "foreignEmploymentExemptionConfirmed","treatyCouponRate","securitiesClassification","securitiesTreatyExemptionConfirmed",
        "preliminaryMethod","preliminaryRate","preliminaryPayer","preliminaryAnnualIncome")
    private static void validateSourceOptions(Map<String,Object> options) {
        keys(options,SOURCE_OPTIONS)
        Object method=options.get("preliminaryMethod"), rate=options.get("preliminaryRate")
        Object payer = options.get("preliminaryPayer"), amount = options.get("preliminaryAnnualIncome")
        require(method==null || "combined".equals(method) || "percent".equals(method) || "table".equals(method) || "lump-table".equals(method),"Invalid preliminary withholding method")
        require(rate==null || rate instanceof Number && Double.isFinite(((Number)rate).doubleValue()) && ((Number)rate).doubleValue()>=0d && ((Number)rate).doubleValue()<=1d,"Invalid preliminary withholding rate")
        require(!"percent".equals(method) || rate!=null,"Percentage withholding requires an explicit rate")
        require(!"table".equals(method) || payer instanceof String && !((String)payer).isBlank(),"Table withholding requires an explicit payer")
        require(!"lump-table".equals(method) || amount instanceof Number && Double.isFinite(((Number)amount).doubleValue()) && ((Number)amount).doubleValue()>=0d,"Lump-sum withholding requires an estimated annual income")
    }
    private static boolean unlimitedAfterEmigration(Map<String,Object> options) {
        String liability=sourceOption(map(options,"rules"),"afterEmigrationLiability","limited")
        require("limited".equals(liability)||"unlimited".equals(liability),"Swedish after-emigration liability must be limited or unlimited.")
        return "unlimited".equals(liability)
    }
    private static Map<String,Object> ordinaryOptions(Map<String,Object> options) {
        unlimitedAfterEmigration(options)
        if(!map(options,"rules").containsKey("afterEmigrationLiability"))return options
        def ordinary=new LinkedHashMap<>(options)
        def rules=new LinkedHashMap<>(map(options,"rules"))
        rules.remove("afterEmigrationLiability")
        ordinary.put("rules",rules)
        return ordinary
    }
    static boolean isMonetaryBasis(String basis) { return !NON_MONETARY_BASES.contains(basis); }
    static Map<String,Object> optionsInRuleMoney(Map<String,Object> options,TaxMoneyBasis prices) {
        def converted=new LinkedHashMap<>(options)
        if(options.containsKey("foreignTaxCredit")) {
            def nativeFields=Set.of("paidAmount","attributableOrdinaryTax")
            converted.put("foreignTaxCredit",prices.convertFields(map(options,"foreignTaxCredit"),nativeFields,nativeFields))
        }
        if(options.containsKey("taxBases")) {
            def bases=map(options,"taxBases")
            def monetary=new HashSet<>(bases.keySet())
            monetary.removeIf(key->!isMonetaryBasis(key))
            converted.put("taxBases",prices.convertFields(bases,monetary))
        }
        if(options.containsKey("propertyAssessments")) {
            List<Map<String,Object>> homes=new ArrayList<>()
            for(def home:properties(options))homes.add(prices.convertFields(home,Set.of("assessmentValue")))
            converted.put("propertyAssessments",homes)
        }
        return converted
    }
    static TaxAssessment assessAnnual(Map<String,Object> options,int birthYear,int birthMonth,
                                       int assessmentYear,Map<String,Double> bases) {
        def ordinary=new LinkedHashMap<>(ordinaryOptions(options))
        // The payment date belongs to the settlement calendar, not the assessment.
        // Keep it in the original policy options for settlementDates().
        ordinary.remove("settlementDate")
        Map<String,Object> foreignCredit=map(ordinary,"foreignTaxCredit")
        ordinary.remove("foreignTaxCredit")
        def input=CountryTaxInputs.swedish(ordinary,birthYear,birthMonth,assessmentYear,bases)
        if(!options.containsKey("foreignTaxCredit"))return assessResolved(input,assessmentYear)
        keys(foreignCredit,Set.of("taxYear","paidAmount","attributableOrdinaryTax","entitlementConfirmed"))
        double creditYear=number(foreignCredit,"taxYear",0)
        require(creditYear==Math.floor(creditYear)&&creditYear>=2025&&creditYear<=9999,
            "Foreign tax credit requires an explicit income taxYear from 2025 through 9999.")
        double paid=number(foreignCredit,"paidAmount",0)
        double attributable=number(foreignCredit,"attributableOrdinaryTax",0)
        boolean confirmed=bool(foreignCredit,"entitlementConfirmed",false)
        def taxBases=new LinkedHashMap<>(map(input,"taxBases"))
        require(!taxBases.containsKey("se.tax.credit.foreign-tax"),
            "Enter foreignTaxCredit inputs or the resolved se.tax.credit.foreign-tax amount, not both.")
        double credit=SwedishEmigrationPolicy.creditForeignTax(paid,confirmed,attributable)
        if(assessmentYear!=(int)creditYear)return assessResolved(input,assessmentYear)
        def before=assessResolved(input,assessmentYear)
        // Conservative remaining ordinary-tax ceiling: all existing credits
        // reduce this ceiling before the new entered credit is applied. Fees,
        // property taxes and definitive source withholding never increase it.
        double remainingOrdinary=Math.max(0,before.components().getOrDefault("tax.municipal",0d)
            +before.components().getOrDefault("tax.state",0d)+before.components().getOrDefault("tax.capital",0d)
            -before.components().getOrDefault("tax.credits",0d))
        taxBases.put("se.tax.credit.foreign-tax",Math.min(credit,remainingOrdinary))
        input.put("taxBases",taxBases)
        return assessResolved(input,assessmentYear)
    }
