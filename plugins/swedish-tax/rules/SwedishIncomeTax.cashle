    private static final Set<String> BASES = Set.of(
        "employment", "pension", "capital.income", "interest.eligible", "se.ink1.1.1",
        "se.ink1.1.1.wage-benefits", "se.ink1.1.1.sickness-activity", "se.ink1.1.1.parental-benefit",
