plugins { id 'cashle.tax.se' }

// Pinned DECCF a5413773 assessment from deccf-golden.tsv.
// TaxPlugin is a pure country API. The authored model books its returned amounts once on the selected annual date.
timeline { from '2025-12-30'; until '2026-01-02' }
def nationalTax = dev.cashle.tax.TaxRegistry.discover(classLoader()).require('SE')
Map<String, Object> resolvedInput = ['dateOfBirth':'1986-01-02', 'taxBases':['employment':600000, 'pension':24000]]
def taxpayer = entity()
def cash = taxpayer.account(); cash.setName('Cash'); cash.setKind(dev.cashle.core.AccountKind.ASSET)
def equity = taxpayer.account(); equity.setKind(dev.cashle.core.AccountKind.EQUITY)
def incomeTax = taxpayer.account(); incomeTax.setName('Income tax'); incomeTax.setKind(dev.cashle.core.AccountKind.EXPENSE)
def social = taxpayer.account(); social.setName('Social contributions'); social.setKind(dev.cashle.core.AccountKind.EXPENSE)
def opening = schedule() on '2025-12-30'
def annual = schedule() on '2025-12-31'
flow { on opening; debit cash; credit equity; amount { 10000000d } }
flow { on annual; debit incomeTax; credit cash; amount { nationalTax.assess(resolvedInput).liability() } }
flow { on annual; debit social; credit cash; amount { nationalTax.assess(resolvedInput).socialContributions() } }
collect { }
