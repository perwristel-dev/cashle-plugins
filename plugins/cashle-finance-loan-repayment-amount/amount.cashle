import dev.cashle.finance.repayment.RecurringRepayment
import dev.cashle.finance.repayment.RepaymentFlow
import dev.cashle.sdk.composition.ModuleInput

financeModule('cashlab.repayment-amount', 1) {
    pluginId 'cashle.finance.loan-repayment.amount'

    dsl('loanRepaymentAmount') { String name ->
        RepaymentFlow.defaults(name) + [amortizationAmount: 0d, amortizationBasis: 'nominal']
    }

    factory { ModuleInput entry ->
        new RepaymentFlow(entry, { RepaymentFlow.Terms terms ->
            def input = entry.data()
            def configured = input.getOrDefault('amortizationAmount', 0d)
            if (!(configured instanceof Number) || !Double.isFinite(configured.doubleValue()) || configured.doubleValue() < 0d) {
                def messages = terms.context().messages(this.class, 'dev.cashle.finance.repayment.amount.messages')
                throw new IllegalArgumentException(messages.text('invalidAmount'))
            }
            double entered = configured.doubleValue()
            boolean indexed = input.amortizationBasis == 'real'
            new RecurringRepayment(terms, { long installment, double outstanding, java.time.LocalDate date ->
                indexed ? entered * terms.context().inflationFactor(date) : entered
            } as RecurringRepayment.PrincipalRule).payments()
        } as java.util.function.Function)
    }
}
