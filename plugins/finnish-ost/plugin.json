{
  "id": "cashle.finance.fi-ost",
  "archive": "cashle-account-fi-ost-source.zip",
  "requires": [
    "cashle.finance",
    "cashle.account.support",
    "cashle.account.tax.support"
  ],
  "ui": "ui.js",
  "uiTranslations": [
    {
      "locale": "en",
      "path": "ui-en.json"
    },
    {
      "locale": "sv",
      "path": "ui-sv.json"
    }
  ],
  "sources": [
    {
      "path": "finnish-ost.cashle",
      "resources": [
        "dev/cashle/accounts/fi_ost/FinnishOstPlugin_en.properties",
        "dev/cashle/accounts/fi_ost/FinnishOstPlugin_sv.properties"
      ]
    },
    {
      "path": "finnish-ost-tax.cashle",
      "resources": [
        "dev/cashle/accounts/fi_ost/FinnishOstTaxPolicy_en.properties",
        "dev/cashle/accounts/fi_ost/FinnishOstTaxPolicy_sv.properties"
      ]
    }
  ]
}
