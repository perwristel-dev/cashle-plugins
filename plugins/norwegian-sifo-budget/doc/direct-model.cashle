plugins {
    id 'cashle.finance'
    id 'groovy-cashle-plugin'
    id 'cashle.finance.budget.no.sifo' from '../norwegian-sifo-budget.cashle'
}
finance {
    plan { from '2026-06-01'; until '2026-08-01'; currency 'NOK'; inflation 0d }
    person('self') { birthYear 1990; birthMonth 6 }
    income 'Example income', 50000d
    norwegianSifoBudget('SIFO') { settings([osloTransit:true]) }
}
collect {}
