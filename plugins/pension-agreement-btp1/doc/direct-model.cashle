plugins {
    id 'cashle.finance'
    id 'cashle.finance.income'
    id 'cashle.pension.types'
    id 'cashle.tax'
    id 'cashle.tax.se' from 'tax.cashlec'
    id 'cashle.balancesheet'
    id 'cashle.finance.pension.dc' from 'dc.cashlec'
    id 'cashle.pension.agreement.BTP1' from 'btp1.cashlec'
    id 'cashle.pension.agreement.BTP1-TRYGG' from 'btp1.cashlec'
    id 'cashle.pension.agreement.BTP1-VALBAR' from 'btp1.cashlec'
}

// Project the protected and selectable portions independently.
finance {
    plan {
        from '2026-03-01'; until '2026-05-01'; currency 'SEK'; inflation 0d
        settings([generalAssumptions:['swedish-pension':[baseAmountIncrease:0d, lifelongDivisionYears:20d]]])
    }
    person('self') { birthYear 1986; birthMonth 1 }
    tax {
        country 'SE'
        preliminaryRate 0d
        options([ruleYear:2025, residentMonths:12, municipality:'0180', municipalRate:0.306d,
                 burialFeeRate:0.00293d, communityMember:false])
    }
    salary('Salary') {
        owner 'self'; amount 250000d; frequency 'monthly'; taxTreatment 'taxable'; taxBasis 'salary'
    }
    dcPension('BTP1-TRYGG') {
        settings([inputMode:'statement', scheme:'BTP1-TRYGG', salaryId:'Salary', capital:0d, growthRate:0d, duration:0d,
                  historicalWageEvents:[[incomeId:'Salary', openingEventIncluded:false]]])
    }
    dcPension('BTP1-VALBAR') {
        settings([inputMode:'statement', scheme:'BTP1-VALBAR', salaryId:'Salary', capital:0d, growthRate:0d, duration:10d,
                  historicalWageEvents:[[incomeId:'Salary', openingEventIncluded:false]]])
    }
}

collect { balancesheet { format json; output 'stdout' } }
