// Owned no-ask DSL calculation regression; synthetic values, version 1.
plugins {
    id 'cashle.finance'
    id 'cashle.finance.no-ask' from '../norwegian-ask.cashle'
    id 'cashle.finance.no-ask.policy' from '../norwegian-ask-tax.cashle'
    id 'cashle.finance.income'
    id 'cashle.tax'
    id 'groovy-cashle-plugin'
    id 'cashle.tax.no' from '../../norwegian-tax/norwegian-tax.cashle'
}
finance {
    language 'en'
    plan { from '2026-01-01'; until '2027-06-01'; currency 'NOK'; inflation 0d }
    person('self') { name 'Synthetic Norwegian investor'; birthYear 1980; birthMonth 1 }
    tax {
        country 'NO'
        preliminaryRate 0d
        options([ruleYear:2026, residency:'full-year', region:'ordinary', youngWorkerTrialSelected:false])
    }
    salary('salary') { name 'Salary'; amount 600000d; frequency 'once'; taxTreatment 'taxable'; taxBasis 'salary' }
    noAsk('portfolio') {
        name 'ASK'
        balance 15000d
        settings([costBasis:10000d, shieldingRate:0d, closeEnabled:true, closeDate:'2026-06-01',
                  initialYear:[openingValue:15000d, minimumPrincipal:10000d,
                               quarterOpeningValues:[null, null, null, null]]])
    }
}
collect { }
