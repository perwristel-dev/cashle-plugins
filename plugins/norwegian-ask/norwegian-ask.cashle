investmentAccount('cashlab.no-ask', 1) {
    pluginId 'cashle.finance.no-ask'
    dsl 'noAsk'
    country 'NO'
    kind 'NOask'
    taxPolicy 'ask'
    messages 'dev.cashle.accounts.no_ask.NorwegianAskPlugin'
    prepaidTax true
    transfers true

    taxInput { entered, active, messages ->
        def settings = new LinkedHashMap(entered)
        settings.remove('shieldingRate')
        settings.shieldingReturnProfile = 'low'
        settings
    }
}
