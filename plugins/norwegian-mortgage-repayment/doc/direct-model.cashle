plugins {
    id 'cashle.finance'
    id 'cashle.finance.assets'
    id 'cashle.finance.debt'
    id 'cashle.balancesheet'
    id 'groovy-cashle-plugin'
    id 'cashle.finance.loan-repayment.no' from '../norwegian-mortgage-repayment.cashle'
}

finance {
    plan { from '2027-01-01'; until '2028-01-01'; currency 'NOK'; inflation 0d }
    person('self') { name 'Kari'; birthYear 1985; birthMonth 1 }
    income 'Lønn', 50000d
    debt('mortgage') { name 'Boliglån'; balance 2200000d; interest 5d }
    house('home') { value 3000000d; settings([linkedLoanIds: ['mortgage']]) }
    norwegianMortgageRepayment('Avdragskrav') {
        settings([homeId: 'home', loanId: 'mortgage', grantedAmount: 2400000d, grantedDate: '2027-01-01'])
    }
}
def principal = model().accounts().find { account -> account.getName() == 'Boliglån' }
collect {
    balancesheet { group 'Mortgage principal', principal; format json; output 'stdout' }
}
