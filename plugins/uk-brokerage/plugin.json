    },
    {
      "path": "uk-brokerage-tax.cashle",
      "resources": [
        "dev/cashle/accounts/gb_brokerage/BritishBrokerageTaxPolicy_en.properties",
        "dev/cashle/accounts/gb_brokerage/BritishBrokerageTaxPolicy_sv.properties"
      ]
