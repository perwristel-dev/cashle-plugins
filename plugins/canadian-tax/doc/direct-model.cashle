plugins {
    id 'cashle.finance'
    id 'cashle.finance.income'
    id 'cashle.tax'
    id 'groovy-cashle-plugin'
    id 'cashle.tax.ca' from '../canadian-tax.cashle'
}

finance {
    plan { from '2026-01-01'; until '2027-01-02'; currency 'CAD'; inflation 0d }
    person('self') { name 'Example resident'; birthYear 1990; birthMonth 1 }
    tax {
        country 'CA'
        preliminaryRate 0d
        options([ruleYear: 2026, residency: 'full-year', province: 'AB',
            openingCapitalLoss: 0d, ontarioReductionDependants: 0, propertyFlippingIncomeConfirmed: false, liftEligible: true])
    }
    customIncome('interest') {
        name 'Interest income'
        amount 50000d
        frequency 'annual'
        settings([taxTreatment: 'taxable', taxBasis: 'capitalIncome'])
    }
}
collect {}
