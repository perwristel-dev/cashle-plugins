plugins {
    id 'cashle.finance'
    id 'cashle.finance.income'
    id 'cashle.cashflow'
    id 'groovy-cashle-plugin'
    id 'cashle.finance.de-life-insurance' from '../german-life-insurance.cashle'
    id 'cashle.finance.de-life-insurance.policy' from '../german-life-insurance.cashle'
    id 'cashle.tax'
    id 'cashle.tax.de' from '../../german-tax/german-tax.cashle'
}
finance {
    language 'en'
    plan { from '2026-01-01'; until '2027-10-01'; currency 'EUR'; inflation 0d }
    person('self') { name 'Policy holder'; birthYear 1980; birthMonth 1 }
    tax {
        country 'DE'
        preliminaryRate 0d
        options([ruleYear: 2026, residency: 'full-year', profile: 'single-childless-statutory',
            churchRate: 0d, healthAdditionalRate: 0.029d, saxony: false,
            employmentExpenses: 0d, churchTaxPaid: 0d,
            settlementCalendar: [month: 9, day: 30, yearOffset: 1, confirmed: true]])
    }
    deLifeInsurance('Policy') {
        balance 15000d
        settings costBasis: 10000d, closeEnabled: true, closeDate: '2026-06-01',
            policyOptions: [acquiredDate: '2020-01-01']
    }
}
collect { cashflow {} }
