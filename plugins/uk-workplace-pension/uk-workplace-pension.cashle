import dev.cashle.core.AccountKind
import dev.cashle.core.AccountTag
import dev.cashle.core.Frequency
import dev.cashle.core.ReportingRole
import dev.cashle.core.i18n.Messages
import dev.cashle.sdk.composition.ModuleContext
import dev.cashle.sdk.composition.ModuleInput
import dev.cashle.sdk.finance.FinanceContext
import dev.cashle.sdk.finance.FinanceModule
import dev.cashle.sdk.finance.FundingPort
import dev.cashle.sdk.finance.MetricsPort
import dev.cashle.sdk.finance.TaxPort
import dev.cashle.sdk.model.AccountHandle
import dev.cashle.sdk.model.FlowHandle
import dev.cashle.sdk.model.ScheduleSpec
import dev.cashle.sdk.model.Variable
import java.time.DateTimeException
import java.time.LocalDate
import java.time.YearMonth
import java.util.function.Supplier

financeModule('cashlab.uk-workplace-pension', 1) {
    pluginId 'cashle.finance.pension.gb.workplace'
    dsl('ukWorkplacePension') { id ->
        [name: id, owner: 'self', openingCapital: 0d, grossMonthlyPay: 0d, annualReturn: 0d,
         payoutMode: 'none', monthlyWithdrawal: 0d, payoutStart: [reference: 'minimum'],
         remainingLumpSumAllowance: 268_275d]
    }
    factory { ModuleInput entry -> new StandardWorkplacePension(entry) }
}

final class StandardWorkplacePension implements FinanceModule {
    private static final String NATURE = 'cashle.household.economic-nature'
    private static final LocalDate RULE_YEAR_START = LocalDate.of(2026, 4, 6)
    private static final LocalDate ACCESS_CHANGE = LocalDate.of(2028, 4, 6)
    private static final double MONTHLY_LOWER = 520d
    private static final double MONTHLY_UPPER = 4189d
    private static final double EMPLOYER = 0.03d
    private static final double GROSS_MEMBER = 0.05d
    private static final double BASIC_RELIEF = 0.20d
    private static final double STANDARD_ALLOWANCE = 268_275d
    private final ModuleInput entry
    private Messages messages
    private String ownerId
    private AccountHandle capital, equity, income
    private FlowHandle employeeCost, taxablePayment, taxFreePayment
    private Variable balance, allowance, payoutGross, payoutTaxFree, completedOn
    private Supplier<LocalDate> death, requestedDate
    private LocalDate birth, earliestSchemeDate, firstContribution, lastContribution, firstScheduledPayment
    private double monthlyPay, monthlyWithdrawal, growth, fx
    private boolean monthly, hasPayout, taxable

    StandardWorkplacePension(ModuleInput entry) { this.entry = entry }

    @Override void declare(ModuleContext ignored) {}

    @Override void declareFinance(FinanceContext context) {
        if (!entry.enabled()) return
        def data = entry.data()
        messages = context.messages(StandardWorkplacePension, 'british.workplacepension.messages')
        ownerId = data.owner ?: 'self'
        def person = context.profile().people.find { it.id == ownerId && it.id != 'joint' }
        require(whole(person?.birthYear, 1900, 2300) && whole(person?.birthMonth, 1, 12), 'invalid.person')
        YearMonth birthMonth = YearMonth.of(person.birthYear.intValue(), person.birthMonth.intValue())
        def birthDay = data.birthDay
        require(birthDay == null || birthDay == '' || whole(birthDay, 1, birthMonth.lengthOfMonth()), 'invalid.person')
        birth = birthDay == null || birthDay == '' ? birthMonth.atEndOfMonth() : birthMonth.atDay(birthDay.intValue())
        String name = data.name instanceof String && !data.name.isBlank() ? data.name : messages.text('name')
        def owner = context.owner(ownerId)
        capital = owner.account().classify(AccountKind.ASSET, new AccountTag(NATURE, 1, 'asset.pension', Set.of(AccountKind.ASSET)))
        capital.setName(name)
        capital.addReportingRole(ReportingRole.PENSION)
        equity = owner.account()
        equity.setKind(AccountKind.EQUITY)
        equity.setName(name + ' – ' + messages.text('equity'))
        require(data.payoutMode in ['none', 'monthly', 'once'], 'invalid.mode')
        hasPayout = data.payoutMode != 'none'
        monthly = data.payoutMode == 'monthly'
        taxable = !context.taxSettings().isEmpty()
        if (hasPayout) {
            income = owner.account().classify(AccountKind.INCOME,
                new AccountTag(NATURE, 1, 'income.pension.occupational', Set.of(AccountKind.INCOME)))
            income.setName(name + ' – ' + messages.text('income'))
            income.addReportingRole(ReportingRole.INCOME)
        }
    }

    @Override void wireFinance(FinanceContext context) {
        if (capital == null) return
        def data = entry.data()
        def model = context.model()
        def clock = model.clock()
        LocalDate from = context.from()
        LocalDate until = context.until()
        death = context.lifeEnd(ownerId)
        fx = context.exchangeRate('GBP', context.profile().currency ?: 'GBP')
        balance = model.variable(number(data.openingCapital, 0d, Double.MAX_VALUE, 'invalid.amount'))
        monthlyPay = number(data.grossMonthlyPay, 0d, Double.MAX_VALUE, 'invalid.amount')
        growth = number(data.annualReturn, -99d, 100d, 'invalid.return') / 100d
        model.valueAccount(capital, equity, { balance.value * fx })

        firstContribution = optionalDate(data.contributionFrom, 'invalid.contribution') ?: from
        lastContribution = optionalDate(data.contributionUntil, 'invalid.contribution')
        require(lastContribution == null || lastContribution > firstContribution, 'invalid.contribution')
        def monthEnds = ScheduleSpec.every(Frequency.MONTH, from.withDayOfMonth(1)).atMonthEnd().within(from, until)
        def accumulate = model.action(monthEnds, {
            LocalDate day = clock.date
            if (alive(day)) balance.value = balance.value * Math.pow(1d + growth, 1d / 12d) + grossContribution(day)
        })
        if (monthlyPay > MONTHLY_LOWER) {
            employeeCost = model.flow(monthEnds, equity, context.cash(), {
                qualifyingPay(clock.date) * GROSS_MEMBER * (1d - BASIC_RELIEF) * fx
            }, accumulate)
        }
        if (!hasPayout) return

        earliestSchemeDate = optionalDate(data.schemeAccessDate, 'invalid.start')
        monthlyWithdrawal = monthly ? number(data.monthlyWithdrawal, 0.01d, Double.MAX_VALUE, 'invalid.withdrawal') : 0d
        allowance = model.variable(number(data.remainingLumpSumAllowance, 0d, STANDARD_ALLOWANCE, 'invalid.allowance'))
        payoutGross = model.variable(0d)
        payoutTaxFree = model.variable(0d)
        completedOn = model.variable(0d)

        Map claim = data.payoutStart instanceof Map ? data.payoutStart : [:]
        boolean milestone = claim.reference == 'milestone' && claim.milestoneId instanceof String && !claim.milestoneId.isBlank()
        LocalDate explicit = claim.reference == 'minimum' ? from : specifiedDate(claim)
        require(claim.getOrDefault('offset', 0) == 0 && (explicit != null || milestone), 'invalid.start')
        requestedDate = milestone ? context.milestoneDate(claim.milestoneId, 0) : { explicit } as Supplier<LocalDate>
        firstScheduledPayment = legalStart(explicit == null || explicit < from ? from : explicit)
        ScheduleSpec paymentDays = milestone ? monthEnds : monthly ?
            ScheduleSpec.every(Frequency.MONTH, firstScheduledPayment).within(from, until) : ScheduleSpec.on(firstScheduledPayment)
        def withdraw = model.action(paymentDays, {
            LocalDate day = clock.date
            LocalDate chosen = requestedDate.get()
            payoutGross.value = 0d
            payoutTaxFree.value = 0d
            if (!alive(day) || chosen == null || day < legalStart(chosen) || !ofAccessAge(day) ||
                    (!monthly && completedOn.value != 0d)) return
            double gross = monthly ? Math.min(monthlyWithdrawal, balance.value) : balance.value
            if (gross <= 0d) return
            double taxFree = Math.min(gross * 0.25d, allowance.value)
            balance.value -= gross
            allowance.value -= taxFree
            payoutGross.value = gross
            payoutTaxFree.value = taxFree
            if (!monthly) completedOn.value = day.toEpochDay()
        }, accumulate)
        taxablePayment = model.flow(paymentDays, context.cash(), income, { (payoutGross.value - payoutTaxFree.value) * fx }, withdraw)
        taxFreePayment = model.flow(paymentDays, context.cash(), equity, { payoutTaxFree.value * fx }, withdraw)
    }

    private double qualifyingPay(LocalDate day) {
        if (!alive(day) || day < RULE_YEAR_START || day < firstContribution || (lastContribution != null && day >= lastContribution) ||
                day < birth.plusYears(16) || day >= birth.plusYears(75)) return 0d
        Math.max(0d, Math.min(monthlyPay, MONTHLY_UPPER) - MONTHLY_LOWER)
    }

    private double grossContribution(LocalDate day) {
        qualifyingPay(day) * (EMPLOYER + GROSS_MEMBER)
    }

    private LocalDate legalStart(LocalDate requested) {
        LocalDate age55 = birth.plusYears(55)
        LocalDate candidate = [requested, age55, earliestSchemeDate ?: age55].max()
        ofAccessAge(candidate) ? candidate : birth.plusYears(57)
    }

    private boolean ofAccessAge(LocalDate day) {
        day >= birth.plusYears(day < ACCESS_CHANGE ? 55 : 57)
    }

    private boolean alive(LocalDate day) {
        LocalDate end = death.get()
        end == null || day < end
    }

    private LocalDate paymentEnd() {
        if (!monthly && completedOn.value != 0d) return LocalDate.ofEpochDay((long) completedOn.value).plusDays(1)
        death.get()
    }

    @Override void funding(FundingPort port) {
        if (employeeCost != null) port.eventFlow(employeeCost, { false })
        if (taxablePayment == null) return
        port.receiptUntil(taxablePayment, taxable ? FundingPort.ReceiptTax.TAXABLE : FundingPort.ReceiptTax.TAX_FREE,
            false, { paymentEnd() })
        port.receiptUntil(taxFreePayment, FundingPort.ReceiptTax.TAX_FREE, false, { paymentEnd() })
    }

    @Override void metrics(MetricsPort port) {
        if (capital != null) port.balance(capital, { balance.value * fx })
        if (income != null) port.income(income, false)
    }

    @Override void tax(TaxPort port) {
        if (income != null && taxable) {
            port.income(ownerId, income, 'pension', monthly ? 'monthly' : 'yearly', 'GB',
                { firstScheduledPayment }, { true }, Map.of())
        }
    }

    private LocalDate specifiedDate(Map claim) {
        if (claim.reference == 'age' && whole(claim.age, 0, 130)) return birth.plusYears(claim.age.longValue())
        if (claim.reference != 'date' || !whole(claim.year, 1900, 2430) || !whole(claim.month, 1, 12) ||
                !whole(claim.getOrDefault('day', 1), 1, 31)) return null
        try { LocalDate.of(claim.year.intValue(), claim.month.intValue(), claim.getOrDefault('day', 1).intValue()) }
        catch (DateTimeException ignored) { null }
    }

    private LocalDate optionalDate(Object value, String key) {
        if (value == null || value == '') return null
        require(value instanceof String, key)
        try { LocalDate.parse(value) }
        catch (DateTimeException ignored) { throw new IllegalArgumentException(messages.text(key)) }
    }

    private static boolean whole(Object value, int min, int max) {
        value instanceof Number && value.doubleValue() >= min && value.doubleValue() <= max && value.doubleValue() == value.intValue()
    }

    private double number(Object value, double min, double max, String key) {
        require(value instanceof Number && Double.isFinite(value.doubleValue()) && value.doubleValue() >= min && value.doubleValue() <= max, key)
        value.doubleValue()
    }

    private void require(boolean valid, String key) {
        if (!valid) throw new IllegalArgumentException(messages.text(key))
    }
}
