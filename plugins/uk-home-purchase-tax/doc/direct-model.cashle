plugins {
    id 'cashle.finance'
    id 'cashle.finance.assets'
    id 'cashle.finance.savings'
    id 'groovy-cashle-plugin'
    id 'cashle.finance.property.gb.acquisition-tax' from '../home-purchase-tax.cashle'
}
finance {
    language 'en'
    plan { from '2026-11-01'; until '2027-02-01'; currency 'GBP'; inflation 0d }
    person('self') { birthYear 1988; birthMonth 2 }
    savings('funds') { balance 1_000_000d }
    house('First home') {
        value 500_000d
        settings([purchasePrice: 500_000d, purchaseBasis: 'nominal', purchaseNecessary: true,
                  purchaseDate: [reference: 'date', year: 2026, month: 12, day: 1, offset: 0]])
    }
    ukHomePurchaseTax('Stamp Duty Land Tax') {
        settings([assetId: 'First home', jurisdiction: 'england-ni', treatment: 'first-time', price: 500_000d])
    }
}
collect { }
