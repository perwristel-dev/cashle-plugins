import dev.cashle.core.AccountKind
import dev.cashle.core.AccountTag
import dev.cashle.core.Frequency
import dev.cashle.sdk.model.ScheduleSpec
import java.time.DateTimeException
import java.time.LocalDate
import java.time.YearMonth
import java.util.function.Supplier

final class GermanPublicPensionDates {
    static boolean integer(Object value, int min, int max) {
        value instanceof Number && Double.isFinite(value.doubleValue()) &&
            value.doubleValue() == value.intValue() && value >= min && value <= max
    }

    static int regularAgeMonths(int cohort) {
        if (cohort >= 1964) return 67 * 12
        if (cohort >= 1959) return 66 * 12 + 2 * (cohort - 1958)
        65 * 12 + Math.max(0, cohort - 1946)
    }

    static LocalDate ageStart(YearMonth birth, long ageMonths, boolean bornOnFirst) {
        birth.plusMonths(ageMonths + (bornOnFirst ? 0 : 1)).atDay(1)
    }

    static LocalDate date(Map entered) {
        def day = entered.getOrDefault('day', 1)
        if (!integer(entered.year, 1900, 9999) || !integer(entered.month, 1, 12) ||
            !integer(day, 1, 31)) return null
        try {
            LocalDate.of(entered.year.intValue(), entered.month.intValue(), day.intValue())
        } catch (DateTimeException ignored) {
            null
        }
    }

    static LocalDate monthOnOrAfter(LocalDate date) {
        date.dayOfMonth == 1 ? date : date.withDayOfMonth(1).plusMonths(1)
    }
}

financeModule('cashlab.german-public-pension', 1) {
    pluginId 'cashle.finance.pension.public.de'
    messages 'german.publicpension.messages'
    dsl('germanPublicPension') { id ->
        [name: id, owner: 'self', grossMonthlyEur: 0d, bornOnFirst: false,
         earliestEarlyMonth: '', payoutStart: [reference: 'minimum', offset: 0]]
    }

    calculation {
        if (!enabled) return
        def person = profile.people.find { it.id == input.owner && it.id != 'joint' }
        requireInput('invalid.owner') { person != null }
        requireInput('invalid.birth') {
            GermanPublicPensionDates.integer(person.birthYear, 1900, 2300) &&
                GermanPublicPensionDates.integer(person.birthMonth, 1, 12) && input.bornOnFirst instanceof Boolean
        }
        requireInput('invalid.amount') {
            input.grossMonthlyEur instanceof Number && Double.isFinite(input.grossMonthlyEur.doubleValue()) &&
                input.grossMonthlyEur >= 0d
        }
        def birth = YearMonth.of(person.birthYear.intValue(), person.birthMonth.intValue())
        boolean bornOnFirst = input.bornOnFirst
        def regular = GermanPublicPensionDates.ageStart(birth,
            GermanPublicPensionDates.regularAgeMonths(birth.year), bornOnFirst)
        LocalDate earliest = regular
        if (input.earliestEarlyMonth != '') {
            LocalDate confirmed = null
            if (input.earliestEarlyMonth instanceof String && input.earliestEarlyMonth.matches('\\d{4}-\\d{2}')) {
                try {
                    confirmed = YearMonth.parse(input.earliestEarlyMonth).atDay(1)
                } catch (DateTimeException ignored) {
                    // Invalid calendar month; report the same localized input error.
                }
            }
            def age63 = GermanPublicPensionDates.ageStart(birth, 63 * 12, bornOnFirst)
            requireInput('invalid.early') { confirmed != null && !confirmed.isBefore(age63) && confirmed.isBefore(regular) }
            earliest = confirmed
        }

        def entered = input.payoutStart
        requireInput('invalid.start') { entered instanceof Map && entered.getOrDefault('offset', 0) == 0 }
        Supplier<LocalDate> requested
        boolean dynamic = entered.reference == 'milestone' && entered.milestoneId instanceof String &&
            !entered.milestoneId.isBlank()
        if (entered.reference == 'minimum') {
            requested = { earliest } as Supplier<LocalDate>
        } else if (entered.reference == 'age') {
            requireInput('invalid.start') { GermanPublicPensionDates.integer(entered.age, 0, 130) }
            def date = GermanPublicPensionDates.ageStart(birth, entered.age.longValue() * 12, bornOnFirst)
            requested = { date } as Supplier<LocalDate>
        } else if (dynamic) {
            requested = milestone(entered.milestoneId)
        } else {
            def date = GermanPublicPensionDates.date(entered)
            requireInput('invalid.start') { entered.reference == 'date' && date != null }
            requested = { date } as Supplier<LocalDate>
        }

        Supplier<LocalDate> claimStart = {
            def date = requested.get()
            if (date == null) return null
            def month = GermanPublicPensionDates.monthOnOrAfter(date)
            month.isBefore(earliest) ? earliest : month
        } as Supplier<LocalDate>
        double amountEur = input.grossMonthlyEur.doubleValue()
        if (amountEur == 0d) return
        def income = owner(input.owner).account {
            name input.name instanceof String && !input.name.isBlank() ? input.name : text('name')
            classify AccountKind.INCOME, new AccountTag('cashle.household.economic-nature', 1,
                'income.pension.public', [AccountKind.INCOME] as Set)
        }
        def death = deathOf(input.owner)
        Supplier<LocalDate> end = {
            def date = death.get()
            date == null ? null : date.withDayOfMonth(1).plusMonths(1)
        } as Supplier<LocalDate>
        def fx = exchangeRate('EUR', profile.currency)
        def period = monthlyFromPlanStart
        def firstMonth = dynamic ? earliest : claimStart.get()
        taxableReceipt(input.owner, 'germanStatutoryPension', 'monthly') {
            on ScheduleSpec.every(Frequency.MONTH, firstMonth).atMonthEnd().within(period.fromInclusive(), period.untilExclusive())
            until end
            debit cash
            credit income
            amount {
                def effective = claimStart.get()
                effective == null || today.isBefore(effective) ? 0d : amountEur * fx * inflationFactor(period.anchor(), today)
            }
        }
    }
}
