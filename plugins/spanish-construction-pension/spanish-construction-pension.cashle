import dev.cashle.core.AccountKind
import dev.cashle.core.AccountTag
import dev.cashle.core.Frequency
import dev.cashle.core.ReportingRole
import dev.cashle.core.i18n.Messages
import dev.cashle.sdk.composition.ModuleContext
import dev.cashle.sdk.composition.ModuleInput
import dev.cashle.sdk.finance.FinanceContext
import dev.cashle.sdk.finance.FinanceModule
import dev.cashle.sdk.finance.FundingPort
import dev.cashle.sdk.finance.MetricsPort
import dev.cashle.sdk.finance.TaxPort
import dev.cashle.sdk.model.AccountHandle
import dev.cashle.sdk.model.FlowHandle
import dev.cashle.sdk.model.ScheduleSpec
import dev.cashle.sdk.model.Variable
import groovy.transform.CompileStatic
import java.time.LocalDate
import java.util.function.Supplier

financeModule('cashlab.spanish-construction-pension', 1) {
    pluginId 'cashle.finance.pension.occupational.es.construction'
    dsl('spanishConstructionPension') { id -> [name:id, owner:'self', capital:0d, contributionMonthly:0d,
        annualReturn:0d, eligibilityDate:'', payoutMode:'monthly', payoutMonths:60, payoutStart:[reference:'minimum', offset:0]] }
    factory { ModuleInput input -> new SpanishConstructionPension(input) }
}

@CompileStatic
final class SpanishConstructionPension implements FinanceModule {
    private final ModuleInput input
    private FinanceContext context
    private Messages messages
    private String ownerId
    private AccountHandle capital, equity, income
    private FlowHandle receipt
    private Variable balance, remaining, transfer
    private Supplier<LocalDate> request, lifeEnd
    private LocalDate eligibility
    private double monthlyGrowth, contribution, exchange
    private int months
    private boolean taxable

    SpanishConstructionPension(ModuleInput input) { this.input = input }
    @Override void declare(ModuleContext ignored) {}

    @Override void declareFinance(FinanceContext finance) {
        context = finance
        messages = finance.messages(SpanishConstructionPension, 'construction.messages')
        Map<String,Object> data = input.data()
        ownerId = Objects.toString(data.get('owner'), 'self')
        if ('joint'.equals(ownerId)) throw invalid('owner')
        String name = Objects.toString(data.get('name'), input.id())
        def owner = finance.owner(ownerId)
        String tags = 'cashle.household.economic-nature'
        capital = owner.account().classify(AccountKind.ASSET, new AccountTag(tags, 1, 'asset.pension', Set.of(AccountKind.ASSET)))
        capital.setName(name)
        capital.addReportingRole(ReportingRole.PENSION)
        capital.addReportingRole(ReportingRole.SAVINGS)
        capital.setInheritable(false)
        equity = owner.account().classify(AccountKind.EQUITY, new AccountTag(tags, 1, 'equity.contribution', Set.of(AccountKind.EQUITY)))
        income = owner.account().classify(AccountKind.INCOME, new AccountTag(tags, 1, 'income.pension.occupational', Set.of(AccountKind.INCOME)))
        income.setName(name)
        income.addReportingRole(ReportingRole.INCOME)
    }

    @Override void wireFinance(FinanceContext finance) {
        Map<String,Object> data = input.data()
        try { eligibility = LocalDate.parse(Objects.toString(data.get('eligibilityDate'), '')) }
        catch (java.time.DateTimeException ignored) { throw invalid('date') }
        if (!(data.get('payoutStart') instanceof Map)) throw invalid('start')
        Map<String,Object> time = new LinkedHashMap<>((Map<String,Object>) data.get('payoutStart'))
        String reference = Objects.toString(time.get('reference'), '')
        double offset = number(time, 'offset', 0d, -1200d, 1200d)
        if (offset != Math.rint(offset)) throw invalid('start')
        if (reference == 'minimum') request = () -> eligibility.plusMonths((long) offset)
        else if (reference in ['age', 'date', 'retirement', 'milestone']) {
            if (reference == 'age' || (reference == 'retirement' && !time.get('personId'))) time.put('personId', ownerId)
            request = finance.timeDate(time)
        } else throw invalid('start')
        lifeEnd = finance.lifeEnd(ownerId)
        Object mode = data.get('payoutMode')
        if (!(mode in ['monthly', 'capital'])) throw invalid('term')
        double duration = mode == 'capital' ? 1d : number(data, 'payoutMonths', 60d, 2d, 600d)
        if (duration != Math.rint(duration)) throw invalid('term')
        months = (int) duration
        monthlyGrowth = Math.pow(1d + number(data, 'annualReturn', 0d, -99d, 100d) / 100d, 1d / 12d)
        contribution = number(data, 'contributionMonthly', 0d, 0d, Double.MAX_VALUE)
        exchange = finance.exchangeRate('EUR', Objects.toString(finance.profile().get('currency'), 'EUR'))
        taxable = !finance.taxSettings().isEmpty()
        def model = finance.model()
        balance = model.variable(number(data, 'capital', 0d, 0d, Double.MAX_VALUE))
        remaining = model.variable(-1d)
        transfer = model.variable(0d)
        model.valueAccount(capital, equity, () -> balance.getValue() * exchange)
        ScheduleSpec period = ScheduleSpec.every(Frequency.MONTH, finance.from().withDayOfMonth(1)).atMonthEnd()
        def action = model.action(period, () -> postMonth(model.clock().getDate()))
        LocalDate firstPayment = finance.from().isAfter(eligibility) ? finance.from() : eligibility
        ScheduleSpec payments = ScheduleSpec.every(Frequency.MONTH, firstPayment.withDayOfMonth(1)).atMonthEnd()
        receipt = model.flow(payments, finance.cash(), income, () -> transfer.getValue(), action)
    }

    private void postMonth(LocalDate today) {
        transfer.setValue(0d)
        LocalDate death = lifeEnd.get()
        if (death != null && death.isBefore(today)) {
            balance.setValue(0d)
            return
        }
        double left = remaining.getValue()
        if (left == 0d) return
        double accrued = balance.getValue() * monthlyGrowth
        if (left < 0d) {
            LocalDate desired = request.get()
            if (desired == null || today.isBefore(desired) || today.isBefore(eligibility)) {
                balance.setValue(accrued + contribution * context.inflationFactor(context.from(), today))
                return
            }
            left = months
        }
        double payout = accrued / left
        transfer.setValue(payout * exchange)
        balance.setValue(accrued - payout)
        remaining.setValue(left - 1d)
    }

    @Override void funding(FundingPort port) {
        port.receiptUntil(receipt, taxable ? FundingPort.ReceiptTax.TAXABLE : FundingPort.ReceiptTax.TAX_FREE, false,
            () -> lifeEnd.get() == null ? null : lifeEnd.get().plusDays(1))
    }

    @Override void metrics(MetricsPort port) {
        port.balance(capital, () -> balance.getValue() * exchange)
        port.income(income, false)
    }

    @Override void tax(TaxPort port) {
        if (taxable) port.income(ownerId, income, 'pension', 'monthly', 'ES', () -> context.from(), () -> true, Map.of())
    }

    private double number(Map<String,Object> data, String key, double fallback, double min, double max) {
        Object raw = data.get(key)
        if (raw == null) return fallback
        if (!(raw instanceof Number)) throw invalid('amount')
        double value = ((Number) raw).doubleValue()
        if (!Double.isFinite(value) || value < min || value > max) throw invalid('amount')
        value
    }

    private IllegalArgumentException invalid(String key) { new IllegalArgumentException(messages.text(key)) }
}
