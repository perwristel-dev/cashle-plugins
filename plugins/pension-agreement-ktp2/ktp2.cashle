import dev.cashle.pension.agreement.PensionAgreement.BenefitInput
import dev.cashle.pension.agreement.PensionAgreement.ContributionInput
import dev.cashle.pension.agreement.PensionAgreement.Kind

import static SwedishAgreementRules.*

def ktp2 = localized('KTP 2', 65, 5)
pensionAgreement('KTP2') {
    pluginId 'cashle.pension.agreement.KTP2'
    kind Kind.DEFINED_BENEFIT
    metadata ktp2('sv')
    localizedMetadata ktp2
    eligible { ContributionInput input -> ktp2Eligible(input) }
    accruedServiceYears { double existing, double increment -> Math.min(30d, existing + increment) }
    canBatchEstimatedServiceByMonth true
    canBatchStatementServiceByMonth true
    annualBenefit { BenefitInput input -> ktp2Benefit(input, input.serviceYears()) }
    incrementalBenefit { BenefitInput previous, BenefitInput current ->
        ktp2Benefit(current, current.serviceYears() - previous.serviceYears())
    }
}

def ktpkPlans = [
    ['KTPK', 'KTPK (Fremia–PTK)', .021d, 2],
    ['KTPK-AFO-HANDELS', 'KTPK (AFO–Handels)', .039d, 5],
    ['KTPK-FOLKSAM', 'KTPK (Folksam)', .035d, 2],
    ['KTPK-LO-TCO-RATTSSKYDD', 'KTPK (LO–TCO Rättsskydd)', .031d, 2],
]
ktpkPlans.each { String id, String label, double rate, int minimumDuration ->
    def ktpk = localized(label, 55, minimumDuration)
    pensionAgreement(id) {
        pluginId "cashle.pension.agreement.${id}"
        kind Kind.DEFINED_CONTRIBUTION
        metadata ktpk('sv')
        localizedMetadata ktpk
        eligible { ContributionInput input -> ktp2Eligible(input) }
        historicalContributionBreakpoints { ContributionInput input -> thresholds(input, 30d) }
        contribution { ContributionInput input -> ktp2Eligible(input) ? cappedPremium(input, rate) : 0d }
    }
}

static boolean ktp2Eligible(ContributionInput input) {
    double ageInYears = age(input)
    ageInYears > 28d && ageInYears < 65d
}

static double ktp2Benefit(BenefitInput input, double serviceYears) {
    double base = yearlyIncomeBase(input.date(), input.baseGrowth())
    double salary = input.salary()
    double fullBenefit = band(salary, 0d, 7.5d * base, .10d) +
            band(salary, 7.5d * base, 20d * base, .65d) +
            band(salary, 20d * base, 30d * base, .325d)
    fullBenefit * Math.min(1d, Math.max(0d, serviceYears) / 30d)
}
